theme
{
	name = "modern"

	view = view.medium

	background
	{
		color = #0B120E
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100

		prefix = 1

		text
		{
			normal = #D7DCC5
			select = #D7DCC5
			normal-disabled = #B7A982
			select-disabled = #B7A982
		}

		back
		{
			select = #354A38
			select-disabled = #18221B
		}
	}

	// font
	// {
	// 	size = 14
	// 	name = "Segoe UI Variable Text"
	// 	weight = 3
	// 	italic = 0
	// }

	border
	{
		enabled = true
		size = 1
		color = #39483A
		opacity = 100
		radius = 16
	}

	shadow
	{
		enabled = true
		size = 5
		opacity = 5
		color = #070D09
	}

	separator
	{
		size = 1
		color = #18221B
	}

	symbol
	{
		normal = #D7DCC5
		select = #D7DCC5
		normal-disabled = #B7A982
		select-disabled = #B7A982
	}

	image
	{
		enabled = true
		color = [#D7DCC5, #D7DCC5, #D7DCC5]
	}
}